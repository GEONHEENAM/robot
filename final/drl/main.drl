# =====================================================================
# 최종 프로젝트 DRL  ─ 퀴즈3 PJ3/main.drl 기반 (작업1·작업2는 그대로 유지)
#
# 추가 명령 (PC GUI / calibrate.py → 로봇)
#   HOME                     홈 이동 후 "AT_HOME"
#   PICK,x,y,angle,slot      (x, y) 막대를 angle 방향에 맞춰 집고 PLACE_UP[slot-1]에 놓음
#                            → 홈 복귀 후 "AT_HOME", 성공하면 "DONE,3"
#   MOVEXY,x,y,z             캘리브레이션용: TCP를 (x, y, z)로 이동 후 "DONE,9"
#   GETPOS                   현재 위치 POS 전송
#
# 현장에서 반드시 확인할 값 (아래 [최종 프로젝트 설정])
#   YAW_SIGN, YAW_OFFSET     막대 각도 → 그리퍼 회전 방향/오프셋
#   GRIP_OFFSET, MIN_DEPTH   집는 높이
#   PICK_X_RANGE, PICK_Y_RANGE  PC config.py의 값과 같게
# =====================================================================

# Socket params
PORT_NUM = 9000

# Home position
HOME = posj(-90, 0, -90, 0, -90, 0)

# Task 2 Params
MEAS_UP = [
    [200, 500, 100, 0, -180, 0],
    [0, 500, 100, 0, -180, 0],
    [-200, 500, 100, 0, -180, 0]
]
PLACE_UP = [
    [200,  600, 100, 0, -180, 0],
    [0, 600, 100, 0, -180, 0],
    [-200, 600, 100, 0, -180, 0]
]

Z_LIMIT = 3.0
PLACE_MARGIN = 2.0
MIN_DEPTH = 7.5

# Force Params
STX = [3000, 3000, 10, 200, 200, 200]
Z_FORCE = 20.0
CONTACT_FORCE = 5.0

# Speed Params
VJ, AJ = 30, 60
VL, AL = 100, 200
VL_DOWN = 50

# ---------------- [최종 프로젝트 설정] ----------------
APPROACH_Z = 100.0                 # 막대 위 접근 높이 (MEAS_UP과 같은 100 mm)
PICK_X_RANGE = [-250.0, 250.0]     # config.py PICK_X_RANGE와 같게
PICK_Y_RANGE = [420.0, 560.0]      # config.py PICK_Y_RANGE와 같게
CALIB_MARGIN = 50.0                # MOVEXY는 집기 영역보다 이만큼 넓게 허용
CALIB_MIN_Z = 5.0                  # MOVEXY 최저 높이 (테이블 충돌 방지)
TOOL_A, TOOL_B = 0.0, -180.0       # 퀴즈3 MEAS_UP 자세 (A, B)
YAW_SIGN = 1.0                     # 막대 각도 → 툴 C 회전 방향 (+1 또는 -1, 현장 확인)
YAW_OFFSET = 90.0                  # 손가락이 막대를 가로질러 잡도록 하는 오프셋 (현장 확인)
GRIP_OFFSET = 0.0                  # 접촉 높이보다 더 내려가서 잡을 깊이 (퀴즈3 작업2는 0)

# Connection
sock = None
rx_buf = ""

def wait_client():
    global sock
    sock = server_socket_open(PORT_NUM)
    tp_log("[SOCK] PC client connected")

def send_msg(msg):
    res = server_socket_write(sock, (msg + "\n").encode())
    if res < 0:
        tp_log("[SOCK] send failed({0}) : {1}".format(res, msg))

    return res

def send_pos(tcp = None):
    """현재 TCP X/Y/Z와 J1~J6을 GUI의 POS 프로토콜로 전송한다."""
    if tcp is None:
        tcp, _ = get_current_posx(DR_BASE)
    joint = get_current_posj()
    send_msg("POS,{0:.3f},{1:.3f},{2:.3f},{3:.3f},{4:.3f},{5:.3f},{6:.3f},{7:.3f},{8:.3f}".format(
        tcp[0], tcp[1], tcp[2],
        joint[0], joint[1], joint[2], joint[3], joint[4], joint[5]))

def read_line():
    global rx_buf
    while True:
        idx = rx_buf.find("\n")
        if idx >= 0:
            line = rx_buf[:idx]
            rx_buf = rx_buf[idx + 1:]
            return line

        res, data = server_socket_read(sock)
        if res < 0:
            tp_log("[SOCK] read failed({0})".format(res))
            return None

        rx_buf += data.decode()


# Robot Control Function
def gripper_close():
    set_tool_digital_output(-1)
    set_tool_digital_output(-2)
    wait(0.5)
    set_tool_digital_output(1)
    wait(0.5)

def gripper_open():
    set_tool_digital_output(-1)
    set_tool_digital_output(-2)
    wait(0.5)
    set_tool_digital_output(2)
    wait(0.5)

def move_jx(pos, v = VJ, a = AJ):
    send_msg("MoveJ Start")
    movejx(pos, v, a, sol=SOL)
    send_msg("MoveJ Done")
    send_pos()

def move_j(pos, v = VJ, a = AJ):
    send_msg("MoveJ Start")
    movej(pos, v, a)
    send_msg("MoveJ Done")
    send_pos()

def move_l(pos, v = VL, a = AL):
    send_msg("MoveL Start")
    movel(pos, v, a)
    send_msg("MoveL Done")
    send_pos()

def move_l_REL(dist, v = VL, a = AL):
    send_msg("MoveL_REL Start")
    movel(dist, mod=DR_MV_MOD_REL, v=v, a=a)
    send_msg("MoveL_REL Done")
    send_pos()

def grip_on():
    send_msg("Gripper ON")
    gripper_close()

def grip_off():
    send_msg("Gripper OFF")
    gripper_open()

def with_z(p, z):
    return posx(p[0], p[1], z, p[3], p[4], p[5])


# Task 1 : Pick and Place
T1_HOME_1   = posx(0, 500, 100, 0, 180, 0)
T1_HOME_2   = posx(0, 700, 100, 0, 180, 0)

T1_PICK_UP_1  = posj(-111.14, -30.82, -86.17, 0, -63.02, -111.14)
T1_PLACE_UP_1 = posj(-67.53, -30.82, -86.17, 0, -63.02, -67.53)

T1_PICK_UP_2  = posj(-105.45, -61.2, -30.66, 0, -88.14, -105.45)
T1_PLACE_UP_2 = posj(-73.56, -61.2, -30.66, 0, -88.14, -73.56)

Z_UP = posx(0, 0, 90, 0, 0, 0)
Z_UP_PLACE = posx(0, 0, 95, 0, 0, 0)
Z_DN = posx(0, 0, -90, 0, 0, 0)
Z_DN_PLACE = posx(0, 0, -85, 0, 0, 0)

VEL, ACC = 60, 60

def task1_pick_place(home, pick, place):
    send_msg("Return HOME")
    move_l(home, 100, 80)

    move_j(pick, VEL, ACC)
    move_l_REL(Z_DN, VEL, ACC)

    grip_on()

    move_l_REL(Z_UP, VEL, ACC)

    move_j(place, VEL, ACC)
    move_l_REL(Z_DN_PLACE, VEL, ACC)

    grip_off()

    move_l_REL(Z_UP_PLACE, VEL, ACC)

    move_l(home, VEL, ACC)

def TASK1():
    gripper_open()

    task1_pick_place(T1_HOME_1, T1_PICK_UP_1, T1_PLACE_UP_1)
    task1_pick_place(T1_HOME_2, T1_PICK_UP_2, T1_PLACE_UP_2)


# Task 2: Height Measurement - Alignment - Pick and Place
def height_measurement(job_id, p_up):
    move_jx(p_up)

    send_msg("Compliance start,{0}".format(job_id))
    task_compliance_ctrl(STX)
    set_desired_force(fd=[0, 0, -Z_FORCE, 0, 0, 0],
                      dir = [0,0,1,0,0,0],
                      mod=DR_FC_MOD_REL)
    wait(0.2)

    contact = False

    while True:
        if check_force_condition(DR_AXIS_Z, min = CONTACT_FORCE, max = CONTACT_FORCE + 5, ref = DR_BASE):
            contact = True
            break
        cur, _ = get_current_posx(DR_BASE)
        if cur[2] < Z_LIMIT:
            break
        wait(0.01)

    cur, _ = get_current_posx(DR_BASE)
    contact_z = cur[2]
    send_pos(cur)

    release_force()
    release_compliance_ctrl()
    send_msg("Compliance finish,{0}".format(job_id))

    move_l(p_up)

    if not contact:
        send_msg("ERROR,{0},no contact".format(job_id))
        return None
    if p_up[2] - contact_z < 1.0:     # 출발하자마자 걸림 = 센서 오프셋/툴 무게 설정 문제
        send_msg("ERROR,{0},false trigger".format(job_id))
        return None
    return contact_z

def TASK2():
    grip_off()

    results = []

    for i in range(len(MEAS_UP)):
        job_id = i + 1

        h = height_measurement(job_id, MEAS_UP[i])
        if h is None:
            return False
        p = MEAS_UP[i]
        send_msg("DATA,{0},{1:.2f},{2:.2f},{3:.2f},{4:.2f}".format(
            job_id, p[0], p[1], p[2], h))
        results.append([job_id, h])

    order = sorted(results, key=lambda r: r[1], reverse = True)
    send_msg("ORDER," + ",".join([str(r[0]) for r in order]))

    for slot in range(len(order)):
        job_id = order[slot][0]
        h = order[slot][1]
        p_up = MEAS_UP[job_id - 1]
        grip_z = max(h, MIN_DEPTH)
        place_z = grip_z + PLACE_MARGIN

        grip_off()
        move_jx(p_up)
        move_l(with_z(p_up, grip_z), v=VL_DOWN)
        grip_on()
        move_l(p_up)
        move_jx(PLACE_UP[slot])
        move_l(with_z(PLACE_UP[slot], place_z), v=VL_DOWN)
        grip_off()
        move_jx(PLACE_UP[slot])

    movej(HOME, v=VJ, a=AJ)

    return True


# =====================================================================
# 최종 프로젝트 추가: HOME / PICK / MOVEXY
# =====================================================================
def in_range(v, r):
    return min(r[0], r[1]) <= v <= max(r[0], r[1])

def norm_grip_yaw(c):
    """그리퍼는 180° 대칭이므로 -90 ~ 90 범위로 맞춰 6축 회전을 줄인다 (케이블 꼬임 방지)."""
    while c >= 90.0:
        c -= 180.0
    while c < -90.0:
        c += 180.0
    return c

def safe_up():
    """낮은 위치에서 바로 movej 하면 옆으로 쓸고 지나갈 수 있으므로 먼저 수직 상승한다."""
    cur, _ = get_current_posx(DR_BASE)
    if cur[2] < APPROACH_Z - 1.0:
        move_l(posx(cur[0], cur[1], APPROACH_Z, cur[3], cur[4], cur[5]))

def go_home():
    safe_up()
    move_j(HOME)
    send_msg("AT_HOME")          # PC는 이 신호 뒤에 카메라 촬영 (로봇 팔이 시야를 가리지 않음)

def pick_xy(x, y, ang, slot):
    """(x, y)의 막대를 ang(로봇 좌표계 긴 축 각도) 방향에 맞춰 집어 PLACE_UP[slot-1]에 놓는다."""
    if not (in_range(x, PICK_X_RANGE) and in_range(y, PICK_Y_RANGE)):
        send_msg("ERROR,PICK,out of pick zone")
        return False
    if slot < 1 or slot > len(PLACE_UP):
        send_msg("ERROR,PICK,bad slot")
        return False

    c = norm_grip_yaw(YAW_SIGN * ang + YAW_OFFSET)
    up = [x, y, APPROACH_Z, TOOL_A, TOOL_B, c]
    send_msg("PICK Accepted,{0:.1f},{1:.1f},yaw {2:.1f},slot {3}".format(x, y, c, slot))

    grip_off()
    h = height_measurement(0, up)        # 퀴즈3 함수 재사용: up 이동 → 힘 접촉 → up 복귀
    if h is None:                        # height_measurement가 이미 ERROR를 보냄
        go_home()
        return False
    send_msg("MEAS,{0:.2f}".format(h))

    grip_z = max(h - GRIP_OFFSET, MIN_DEPTH)
    move_l(with_z(up, grip_z), v=VL_DOWN)
    grip_on()
    move_l(up)

    place = PLACE_UP[slot - 1]
    move_jx(place)
    move_l(with_z(place, grip_z + PLACE_MARGIN), v=VL_DOWN)
    grip_off()
    move_l(place)

    go_home()
    return True

def move_xy(x, y, z):
    """캘리브레이션용: 그리퍼 중심(TCP)을 (x, y, z)로 내린다. 기본 자세(C=0)."""
    rx = [PICK_X_RANGE[0] - CALIB_MARGIN, PICK_X_RANGE[1] + CALIB_MARGIN]
    ry = [PICK_Y_RANGE[0] - CALIB_MARGIN, PICK_Y_RANGE[1] + CALIB_MARGIN]
    if z < CALIB_MIN_Z or not (in_range(x, rx) and in_range(y, ry)):
        send_msg("ERROR,MOVEXY,out of range")
        return False
    safe_up()
    up = [x, y, APPROACH_Z, TOOL_A, TOOL_B, 0.0]
    move_jx(up)
    move_l(with_z(up, z), v=VL_DOWN)
    return True


# Main: server open - wait for order - action
movej(HOME, v=VJ, a=AJ)
gripper_open()
SOL = get_current_solution_space()

wait_client()
send_msg("READY")
send_pos()

while True:
    cmd = read_line()

    if cmd is None:
        tp_log("[SOCK] client disconnected")
        break

    cmd = cmd.strip()

    if cmd == "TASK,1":
        send_msg("TASK 1 Accepted")
        TASK1()
        send_msg("DONE,1")

    elif cmd == "TASK,2":
        send_msg("TASK 2 Accepted")
        ok = TASK2()
        if ok:
            send_msg("DONE,2")
        else:
            send_msg("Task 2 Failed")

    elif cmd == "HOME":
        go_home()

    elif cmd.startswith("PICK,"):
        parts = cmd.split(",")
        try:
            px = float(parts[1])
            py = float(parts[2])
            pa = float(parts[3])
            ps = int(parts[4])
        except (ValueError, IndexError):
            send_msg("ERROR,PICK,bad arguments")
            continue
        if pick_xy(px, py, pa, ps):
            send_msg("DONE,3")

    elif cmd.startswith("MOVEXY,"):
        parts = cmd.split(",")
        try:
            mx = float(parts[1])
            my = float(parts[2])
            mz = float(parts[3])
        except (ValueError, IndexError):
            send_msg("ERROR,MOVEXY,bad arguments")
            continue
        if move_xy(mx, my, mz):
            send_msg("DONE,9")

    elif cmd == "GETPOS":
        send_pos()

    elif cmd == "END":
        send_msg("END Received")
        break

    else:
        send_msg("UNKNOWN " + cmd)

server_socket_close(sock)
tp_log("[MAIN] program end")
